generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  companyName String?  @map("company_name")
  planTier    String   @default("free") @map("plan_tier")
  
  apiKeys     ApiKey[]
  intents     Intent[]
  usageLogs   UsageLog[]
  invoices    Invoice[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("users")
}

model ApiKey {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  keyHash         String    @unique @map("key_hash")
  keyPrefix       String    @map("key_prefix")
  name            String?
  rateLimitPerHour Int      @default(1000) @map("rate_limit_per_hour")
  isActive        Boolean   @default(true) @map("is_active")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  intents         Intent[]
  
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@map("api_keys")
}

model Intent {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  apiKeyId            String    @map("api_key_id")
  
  fromChain           String    @map("from_chain")
  fromToken           String    @map("from_token")
  fromAmount          String    @map("from_amount")
  toChain             String    @map("to_chain")
  toToken             String    @map("to_token")
  minToAmount         String?   @map("min_to_amount")
  
  userWalletAddress   String    @map("user_wallet_address")
  
  intentHash          String?   @unique @map("intent_hash")
  quoteId             String?   @map("quote_id")
  status              String    @default("pending")
  
  txHash              String?   @map("tx_hash")
  actualOutputAmount  String?   @map("actual_output_amount")
  executionTimeMs     Int?      @map("execution_time_ms")
  
  platformFeeUsd      Decimal?  @map("platform_fee_usd") @db.Decimal(20, 8)
  networkFeeUsd       Decimal?  @map("network_fee_usd") @db.Decimal(20, 8)
  
  webhookUrl          String?   @map("webhook_url")
  metadata            Json?
  errorMessage        String?   @map("error_message")
  
  user                User      @relation(fields: [userId], references: [id])
  apiKey              ApiKey    @relation(fields: [apiKeyId], references: [id])
  usageLogs           UsageLog[]
  
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  completedAt         DateTime? @map("completed_at")
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("intents")
}

model UsageLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  intentId      String?  @map("intent_id")
  apiCallType   String   @map("api_call_type")
  
  feeChargedUsd Decimal? @map("fee_charged_usd") @db.Decimal(20, 8)
  volumeUsd     Decimal? @map("volume_usd") @db.Decimal(20, 8)
  
  user          User     @relation(fields: [userId], references: [id])
  intent        Intent?  @relation(fields: [intentId], references: [id])
  
  timestamp     DateTime @default(now())
  
  @@index([userId, timestamp])
  @@map("usage_logs")
}

model Invoice {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  
  billingPeriodStart  DateTime  @map("billing_period_start") @db.Date
  billingPeriodEnd    DateTime  @map("billing_period_end") @db.Date
  
  subscriptionFeeUsd  Decimal   @map("subscription_fee_usd") @db.Decimal(10, 2)
  usageFeeUsd         Decimal   @map("usage_fee_usd") @db.Decimal(10, 2)
  totalAmountUsd      Decimal   @map("total_amount_usd") @db.Decimal(10, 2)
  
  status              String    @default("pending")
  stripeInvoiceId     String?   @map("stripe_invoice_id")
  
  user                User      @relation(fields: [userId], references: [id])
  
  paidAt              DateTime? @map("paid_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  
  @@map("invoices")
}

model TokenPrice {
  tokenId   String   @id @map("token_id")
  priceUsd  Decimal  @map("price_usd") @db.Decimal(20, 8)
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("token_prices")
}
