import { logger } from '../utils/logger';
import { env } from '../config/env';

export class NEARIntentsService {
  private baseUrl: string;
  private jwtToken: string;

  constructor() {
    this.baseUrl = 'https://1click.chaindefuser.com';
    this.jwtToken = env.ONECLICK_JWT_TOKEN || '';
  }

  async init() {
    if (!this.jwtToken) {
      logger.warn('OneClick JWT token not configured - using mock mode');
    } else {
      logger.info('NEAR Intents Service initialized with OneClick API');
    }
  }

  private getAssetId(token: string, chain: string): string {
    const assetMap: Record<string, string> = {
      'wNEAR': 'nep141:wrap.near',
      'NEAR': 'nep141:wrap.near',
      'USDC': 'nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1',
      'USDT': 'nep141:usdt.tether-token.near',
      'ETH': 'nep141:eth.bridge.near',
      'WETH': 'nep141:eth.bridge.near',
      'DAI': 'nep141:6b175474e89094c44da98b954eedeac495271d0f.factory.bridge.near',
      'BTC': 'nep141:2260fac5e5542a773aa44fbcfedf7c193bc2c599.factory.bridge.near',
      'WBTC': 'nep141:2260fac5e5542a773aa44fbcfedf7c193bc2c599.factory.bridge.near'
    };
    return assetMap[token] || 'nep141:' + token.toLowerCase() + '.near';
  }

  async getQuote(params: { fromAsset: string; toAsset: string; amount: string; }): Promise<any> {
    try {
      const fromAssetId = this.getAssetId(params.fromAsset, 'near');
      const toAssetId = this.getAssetId(params.toAsset, 'near');

      // Deadline is 5 minutes from now
      const deadline = new Date(Date.now() + 5 * 60 * 1000).toISOString();

      logger.info({ fromAssetId, toAssetId, amount: params.amount, deadline }, 'Requesting quote from OneClick API');

      const url = this.baseUrl + '/v0/quote';
      const response = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + this.jwtToken
        },
        body: JSON.stringify({
          dry: false,
          depositMode: 'SIMPLE',
          swapType: 'EXACT_INPUT',
          slippageTolerance: 100,
          originAsset: fromAssetId,
          depositType: 'INTENTS',
          destinationAsset: toAssetId,
          amount: params.amount,
          refundTo: 'agentfi-dev-1762307277.testnet',
          refundType: 'INTENTS',
          recipient: 'agentfi-dev-1762307277.testnet',
          recipientType: 'INTENTS',
          deadline: deadline
        })
      });

      if (!response.ok) {
        const errorText = await response.text();
        logger.error({ status: response.status, errorText }, 'Quote request failed');
        throw new Error('Quote request failed: ' + response.statusText + ' - ' + errorText);
      }

      const data = await response.json();
      logger.info({ quote: data }, 'Quote received from OneClick API');

      // Extract quote data from response
      const quote = data.quote || data;
      
      return {
        quoteId: data.id || quote.id || 'quote-' + Date.now(),
        depositAddress: quote.depositAddress || data.depositAddress,
        estimatedOutput: quote.amountOut || quote.minAmountOut || '0',
        fees: {
          platform: '0.00',
          network: '0.50',
          total: '0.50'
        },
        validUntil: deadline
      };

    } catch (error: any) {
      logger.error({ error: error.message }, 'Failed to get quote from OneClick API');
      throw error;
    }
  }

  async getSupportedTokens(): Promise<any[]> {
    try {
      const response = await fetch('https://api-mng-console.chaindefuser.com/api/tokens');
      
      if (!response.ok) {
        logger.warn('Failed to fetch tokens from Defuse API, using fallback');
        return this.getFallbackTokens();
      }

      const data = await response.json();
      return data.items || data.tokens || [];

    } catch (error) {
      logger.error({ error }, 'Error fetching tokens from Defuse API');
      return this.getFallbackTokens();
    }
  }

  private getFallbackTokens(): any[] {
    return [
      { symbol: 'wNEAR', name: 'Wrapped NEAR', decimals: 24, priceUsd: 1.84 },
      { symbol: 'USDC', name: 'USD Coin', decimals: 6, priceUsd: 1.00 },
      { symbol: 'USDT', name: 'Tether', decimals: 6, priceUsd: 1.00 },
      { symbol: 'ETH', name: 'Ethereum', decimals: 18, priceUsd: 2000.00 },
      { symbol: 'DAI', name: 'Dai Stablecoin', decimals: 18, priceUsd: 1.00 },
      { symbol: 'WBTC', name: 'Wrapped Bitcoin', decimals: 8, priceUsd: 45000.00 },
      { symbol: 'SOL', name: 'Solana', decimals: 9, priceUsd: 142.50 },
      { symbol: 'BTC', name: 'Bitcoin', decimals: 8, priceUsd: 45000.00 }
    ];
  }
}

export const nearIntentsService = new NEARIntentsService();
