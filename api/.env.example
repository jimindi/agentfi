# Node Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5433/agentfi_dev

# Redis
REDIS_URL=redis://localhost:6379

# NEAR Configuration
# For development: Use testnet
# For production: Use mainnet
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=your-account.testnet
NEAR_PUBLIC_KEY=ed25519:YourPublicKey
NEAR_PRIVATE_KEY=ed25519:YourPrivateKey

# OneClick API
# Get your JWT token from: https://1click.chaindefuser.com
ONECLICK_JWT_TOKEN=your_jwt_token_here

# JWT & Security
# Generate secure random strings for production
JWT_SECRET=your_jwt_secret_minimum_32_chars
WEBHOOK_SECRET=your_webhook_secret_minimum_32_chars

# API Configuration
# Development: http://localhost:3000
# Production: https://api.agentfi.divindi.tech
API_BASE_URL=http://localhost:3000

# Platform Fee Collection
FEE_RECIPIENT_ACCOUNT=your-fee-recipient.near
PLATFORM_FEE_BPS=15
MIN_SWAP_VALUE_USD=5.00
AGENTFI_FEE_WALLET=your-fee-wallet.near
